{
  "설명": "Notion UI에서 생성하거나 기존 DB 속성에 매핑하는 표준 명세. API 생성 요청 본문이 아닙니다.",
  "properties": {
    "작업 ID": { "type": "unique_id", "prefix": "TASK" },
    "이름": { "type": "title" },
    "마감일": { "type": "date" },
    "담당자": { "type": "people" },
    "작업 유형": { "type": "select", "options": ["기능", "버그", "문서", "기타"] },
    "우선순위": { "type": "select", "options": ["긴급", "높음", "보통", "낮음"] },
    "상태": { "type": "status", "options": ["미시작", "진행 중", "완료", "취소"] },
    "생성일": { "type": "created_time" },
    "상위 작업": { "type": "relation", "target": "동일 data source", "paired_with": "하위 작업" },
    "하위 작업": { "type": "relation", "target": "동일 data source", "paired_with": "상위 작업" },
    "Discord": { "type": "url" },
    "요청 ID": { "type": "rich_text" }
  },
  "description": "페이지 본문. Discord에는 첫 25개 최상위 텍스트 블록의 700자 요약과 원문 링크 표시."
}
