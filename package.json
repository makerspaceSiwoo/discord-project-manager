{
  "name": "discord-project-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply project-manager --local",
    "db:remote": "wrangler d1 migrations apply project-manager --remote",
    "seed": "node scripts/config.mjs config/project.example.json --local",
    "setup": "node scripts/setup.mjs",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  },
  "engines": {
    "node": ">=22"
  }
}
